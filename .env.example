# =====================================================================
# GATHERLY - ENVIRONMENT CONFIGURATION EXAMPLE (.env)
# =====================================================================

# 1. CORE APPLICATION SECURITY
# Generate any long random string (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=gatherly-super-secret-key-change-this-in-production

# Optional: Set to 'true' in production on Render (requires HTTPS)
SESSION_COOKIE_SECURE=false

# Optional: Public URL of your deployed site (e.g., https://gatherly.onrender.com)
APP_BASE_URL=

# 2. EMAIL DELIVERY VIA EMAILJS (RECOMMENDED FOR RENDER FREE TIER)
# -------------------------------------------------------------
# EmailJS connects directly to your personal Gmail (or Outlook) via Google OAuth.
# It runs over HTTPS (Port 443 - NEVER blocked by Render Free Tier!)
# It sends to ANY recipient with NO domain verification required!
# Get these from https://dashboard.emailjs.com:
# - Service ID: Email Services -> Add Service (e.g. Gmail) -> Copy Service ID
# - Public Key: Account -> General -> Public Key
# - Private Key: Account -> Security -> Private Key (optional but recommended)
# - Template ID: Email Templates -> Create Template -> Copy Template ID
EMAILJS_SERVICE_ID=service_your_service_id
EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_PRIVATE_KEY=your_private_key_here
EMAILJS_TEMPLATE_ID=template_general_id

# Optional: Specific Template IDs if you want custom templates per mail type
# (If omitted, Gatherly uses EMAILJS_TEMPLATE_ID for all emails)
EMAILJS_OTP_TEMPLATE_ID=
EMAILJS_TICKET_TEMPLATE_ID=
EMAILJS_INVITE_TEMPLATE_ID=
EMAILJS_UPDATE_TEMPLATE_ID=

# OPTION B: DIRECT GMAIL SMTP (For Local Development, VPS, or Render Paid Starter Plan)
# Your Gmail address used to send verification codes & tickets
GMAIL_USER=your-email@gmail.com
# 16-character Google App Password (NOT your regular Gmail password)
# Get it at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# 3. SUPER ADMIN BOOTSTRAP
# Password for admin@gatherly.in (must be at least 12 characters)
SUPER_ADMIN_PASSWORD=superadminpassword123

# 4. GOOGLE GEMINI AI ASSISTANT
# Free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 5. FEATURE FLAGS
PAYMENTS_ENABLED=false

# =====================================================================
# SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# =====================================================================
# 1. Supabase Project REST API (From Supabase Dashboard -> Project Settings -> API)
# e.g., https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase API Key (service_role secret key or anon key from Project Settings -> API)
SUPABASE_KEY=your-supabase-api-key-here

# 2. Database Connection (Choose OPTION A or OPTION B):
# -------------------------------------------------------------
# OPTION A (Simplest): Enter your Supabase Database Password here (Gatherly auto-constructs the URI)
SUPABASE_DB_PASSWORD=your-supabase-database-password

# OPTION B: Or paste the full URI from Project Settings -> Database -> Connection string -> URI
# e.g., postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_DB_URL=
