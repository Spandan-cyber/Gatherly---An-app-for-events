SECRET_KEY=your-secret-key-here
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
SUPER_ADMIN_PASSWORD=your-super-admin-password
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# =====================================================================
# SUPABASE CONFIGURATION
# =====================================================================
# 1. Supabase Project REST API (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase API Key (service_role secret key or anon public key from Project Settings -> API)
SUPABASE_KEY=your-supabase-key-here

# 2. Supabase Database Connection (Choose OPTION A or OPTION B):
# -------------------------------------------------------------
# OPTION A: Just provide your Supabase Database Password (Gatherly will auto-connect):
SUPABASE_DB_PASSWORD=your-database-password-here

# OPTION B: Or paste the full URI from Project Settings -> Database -> Connection string:
# DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_DB_URL=
